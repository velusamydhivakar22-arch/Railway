# ==============================================================================
# PAYANAM JUNCTION — RAILCONNECT ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure values before starting the application.
# IMPORTANT: DO NOT commit production secrets or real passwords to source control.
# ==============================================================================

# Database Configuration (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=payanam_junction
DB_USERNAME=railconnect
DB_PASSWORD=your_secure_db_password_here
DB_ROOT_PASSWORD=your_secure_root_password_here

# Backend Server Configuration
SERVER_PORT=8080
API_BASE_URL=/api/v1

# Spring Security & JWT Settings
# Generate a cryptographically secure 256-bit secret (e.g. openssl rand -hex 32)
JWT_SECRET=your_base64_or_hex_encoded_256_bit_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# Admin Bootstrap Credentials (Initial setup)
ADMIN_USERNAME=admin@railconnect.in
ADMIN_PASSWORD=your_secure_admin_password_here

# Frontend Configuration
FRONTEND_PORT=80
VITE_API_BASE_URL=http://localhost:8080/api/v1
